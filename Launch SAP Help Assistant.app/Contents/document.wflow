				<dict>
					<key>COMMAND_STRING</key>
					<string>osascript -e 'display dialog "SAP Help Assistant is starting, please wait..." with title "SAP Help Assistant" buttons {"OK"} default button "OK" giving up after 3' &amp;

# Kill any existing instance on port 5001
lsof -ti:5001 | xargs kill -9 2&gt;/dev/null

# Start Flask in background
/Users/I560320/.pyenv/shims/python3 "/Users/I560320/mcp-servers/sap-help/web-app/app.py" &gt; /tmp/sap_help_assistant.log 2&gt;&amp;1 &amp;
FLASK_PID=$!

# Wait for server to be ready (up to 30 seconds)
for i in {1..30}; do
  sleep 1
  if curl -s http://localhost:5001 &gt;/dev/null 2&gt;&amp;1; then
    open http://localhost:5001
    exit 0
  fi
done

# Server failed to start
kill $FLASK_PID 2&gt;/dev/null
ERROR=$(tail -5 /tmp/sap_help_assistant.log)
osascript -e "display alert \"Launch Failed\" message \"Service failed to start. Please try again.\n\nError:\n${ERROR}\""</string>
