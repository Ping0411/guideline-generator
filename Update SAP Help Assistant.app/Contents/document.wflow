				<dict>
					<key>COMMAND_STRING</key>
					<string># Load user shell environment
export PATH="$HOME/.pyenv/shims:$HOME/.pyenv/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
eval "$(pyenv init - 2&gt;/dev/null)" || true

# Find update.sh in common locations
UPDATE_SH=""
for dir in "$HOME/mcp-servers/sap-help" "$HOME/BusinessNetwork-Help-MCP" "$HOME/Desktop/BusinessNetwork-Help-MCP" "$HOME/Documents/BusinessNetwork-Help-MCP" "$HOME/Downloads/BusinessNetwork-Help-MCP"; do
  if [ -f "$dir/update.sh" ]; then
    UPDATE_SH="$dir/update.sh"
    PROJECT_DIR="$dir"
    break
  fi
done

if [ -z "$UPDATE_SH" ]; then
  osascript -e 'display alert "Update Failed" message "Cannot find the project folder. Please make sure the app is in the same folder as the project."'
  exit 1
fi

# Run update.sh in a new Terminal window so user can see progress
osascript &lt;&lt;EOF
tell application "Terminal"
  activate
  do script "cd '$PROJECT_DIR' && bash update.sh; echo ''; echo 'Press any key to close...'; read -n 1"
end tell
EOF</string>
