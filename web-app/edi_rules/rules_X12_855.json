{
  "transaction": "X12-855",
  "direction": "cXML-to-X12",
  "document_type": "ConfirmationRequest",
  "segments": [
    {
      "segment_id": "ISA",
      "loop": "unknown",
      "description": "Generated by this._ISA(false). Standard interchange envelope.",
      "elements": [],
      "condition": "fixed_envelope"
    },
    {
      "segment_id": "GS",
      "loop": "unknown",
      "description": "Generated by this._GS(false, 'PR'). Functional group PR = Purchase Order Acknowledgment.",
      "elements": [],
      "condition": "fixed_envelope"
    },
    {
      "segment_id": "ST",
      "loop": "unknown",
      "description": "Generated by this._ST('855'). Transaction set 855.",
      "elements": [],
      "condition": "fixed_envelope"
    },
    {
      "segment_id": "BAK",
      "loop": "unknown",
      "description": "Beginning Segment for Purchase Order Acknowledgment",
      "elements": [
        {
          "position": 1,
          "name": "Transaction Set Purpose Code",
          "cxml_xpath": "@operation (on ConfirmationHeader)",
          "lookup": "mapBAK353",
          "lookup_values": {
            "new": "00",
            "update": "05"
          }
        },
        {
          "position": 2,
          "name": "Acknowledgment Type",
          "cxml_xpath": "@type (on ConfirmationHeader)",
          "lookup": "mapBAK587",
          "lookup_values": {
            "detail": "AC",
            "alldetail": "AC",
            "except": "AE",
            "accept": "AT",
            "reject": "RJ"
          }
        },
        {
          "position": 3,
          "name": "Purchase Order Number",
          "cxml_xpath": "@orderID (on OrderReference)"
        },
        {
          "position": 4,
          "name": "Purchase Order Date",
          "cxml_xpath": "@orderDate (on OrderReference)",
          "transform": "YYYYMMDD (first 8 chars after removing all non-digits). Defaults to '20990909' if empty."
        },
        {
          "position": 8,
          "name": "Application Reference Number (confirmID)",
          "cxml_xpath": "@confirmID (on ConfirmationHeader)"
        }
      ],
      "condition": null
    },
    {
      "segment_id": "CUR",
      "loop": "unknown",
      "description": "Currency (header level) — emitted only if ConfirmationHeader/Total/Money/@currency exists",
      "elements": [
        {
          "position": 1,
          "value_fixed": "BY"
        },
        {
          "position": 2,
          "cxml_xpath": "Total/Money/@currency (on ConfirmationHeader)"
        },
        {
          "position": 3,
          "cxml_xpath": "Total/Money/@alternateAmount (on ConfirmationHeader)",
          "condition": "both @alternateAmount and @alternateCurrency present"
        },
        {
          "position": 4,
          "value_fixed": "BY",
          "condition": "same as pos 3"
        },
        {
          "position": 5,
          "cxml_xpath": "Total/Money/@alternateCurrency (on ConfirmationHeader)",
          "condition": "same as pos 3"
        }
      ],
      "condition": "ConfirmationHeader/Total/Money/@currency is present"
    },
    {
      "segment_id": "REF",
      "loop": "unknown",
      "description": "Reference Identification — header fixed qualifiers (IV, ON, CR, ZB, D2). Each emitted only if value non-empty.",
      "elements": [],
      "condition": null
    },
    {
      "segment_id": "REF",
      "loop": "for each Extrinsic on ConfirmationHeader",
      "description": "Reference Identification — ZZ qualifier per Extrinsic element on ConfirmationHeader. Excludes names in _arrExcludeREF_ZZ=['RejectionReason','RejectionReasonComments'].",
      "elements": [
        {
          "position": 1,
          "value_fixed": "ZZ"
        },
        {
          "position": 2,
          "cxml_xpath": "Extrinsic/@name (on ConfirmationHeader)"
        },
        {
          "position": 3,
          "cxml_xpath": "Extrinsic/text() (on ConfirmationHeader)"
        }
      ],
      "condition": null
    },
    {
      "segment_id": "FOB",
      "loop": "unknown",
      "description": "F.O.B. Related Instructions — emitted only if ConfirmationHeader/@incoTerms is present",
      "elements": [
        {
          "position": 1,
          "value_fixed": "DE"
        },
        {
          "position": 4,
          "value_fixed": "01"
        },
        {
          "position": 5,
          "cxml_xpath": "@incoTerms (on ConfirmationHeader)",
          "lookup": "mapFOB335",
          "lookup_values": {
            "cfr": "CFR",
            "cif": "CIF",
            "cip": "CIP",
            "cpt": "CPT",
            "daf": "DAF",
            "ddp": "DDP",
            "ddu": "DDU",
            "deq": "DEQ",
            "des": "DES",
            "exw": "EXW",
            "fas": "FAS",
            "fca": "FCA",
            "fob": "FOB"
          }
        }
      ],
      "condition": "ConfirmationHeader/@incoTerms present"
    },
    {
      "segment_id": "SAC",
      "loop": "unknown",
      "description": "Service, Promotion, Allowance, or Charge — Shipping at header level",
      "elements": [
        {
          "position": 1,
          "value_fixed": "C"
        },
        {
          "position": 2,
          "value_fixed": "G830"
        },
        {
          "position": 5,
          "cxml_xpath": "Shipping/Money (on ConfirmationHeader)",
          "transform": "multiply by 100 (integer cents)"
        },
        {
          "position": 13,
          "cxml_xpath": "Shipping/@trackingId (on ConfirmationHeader)"
        },
        {
          "position": 14,
          "cxml_xpath": "Shipping/@trackingDomain (on ConfirmationHeader)"
        },
        {
          "position": 15,
          "cxml_xpath": "Shipping/Description text (on ConfirmationHeader)",
          "transform": "max 80 chars"
        },
        {
          "position": 16,
          "cxml_xpath": "Shipping/Description/@xml:lang (on ConfirmationHeader)"
        }
      ],
      "condition": "ConfirmationHeader/Shipping/Money is present"
    },
    {
      "segment_id": "SAC",
      "loop": "unknown",
      "description": "Service, Promotion, Allowance, or Charge — Tax at header level",
      "elements": [
        {
          "position": 1,
          "value_fixed": "C"
        },
        {
          "position": 2,
          "value_fixed": "H850"
        },
        {
          "position": 5,
          "cxml_xpath": "Tax/Money (on ConfirmationHeader)",
          "transform": "multiply by 100 (integer cents)"
        },
        {
          "position": 15,
          "cxml_xpath": "Tax/Description text (on ConfirmationHeader)",
          "transform": "max 80 chars"
        },
        {
          "position": 16,
          "cxml_xpath": "Tax/Description/@xml:lang (on ConfirmationHeader)"
        }
      ],
      "condition": "ConfirmationHeader/Tax/Money is present"
    },
    {
      "segment_id": "SAC",
      "loop": "unknown",
      "description": "Service, Promotion, Allowance, or Charge — from Total/Modifications/Modification on header",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "DTM",
      "loop": "unknown",
      "description": "Date/Time Reference — order date and notice date",
      "elements": [],
      "condition": null
    },
    {
      "segment_id": "TXI",
      "loop": "for each TaxDetail where @purpose='tax'",
      "description": "Tax Information — header level TaxDetail loop (purpose='tax' only)",
      "elements": [
        {
          "position": 1,
          "name": "Tax Type Code",
          "logic": "if @category present use mapTXI963_Category; else if Description text present use mapTXI963_Desc; default 'ZZ'",
          "lookup": "mapTXI963_Category + mapTXI963_Desc"
        },
        {
          "position": 2,
          "cxml_xpath": "TaxAmount/Money (on TaxDetail)"
        },
        {
          "position": 3,
          "cxml_xpath": "@percentageRate (on TaxDetail)"
        },
        {
          "position": 4,
          "value_fixed": "VD"
        },
        {
          "position": 5,
          "cxml_xpath": "TaxLocation (on TaxDetail)",
          "transform": "max 10 chars"
        },
        {
          "position": 6,
          "cxml_xpath": "@exemptDetail (on TaxDetail)",
          "transform": "'exempt' → '2', 'zeroRated' → '0'"
        },
        {
          "position": 8,
          "cxml_xpath": "TaxableAmount/Money (on TaxDetail)"
        },
        {
          "position": 10,
          "cxml_xpath": "Description text (on TaxDetail)",
          "transform": "trimmed"
        }
      ],
      "condition": "ConfirmationHeader/Tax/TaxDetail[@purpose='tax']"
    },
    {
      "segment_id": "N9",
      "loop": "unknown",
      "description": "Reference Number — header Comments, RejectionReason, Shipping/Tax descriptions. See _N9_Header.",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "N1",
      "loop": "for each Contact in ConfirmationHeader",
      "description": "Name group — per Contact element on ConfirmationHeader. See _GroupN1.",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "PO1",
      "loop": "for each ConfirmationItem in /ConfirmationRequest",
      "description": "Baseline Item Data — per ConfirmationItem",
      "elements": [
        {
          "position": 1,
          "cxml_xpath": "@lineNumber (on ConfirmationItem)"
        },
        {
          "position": 2,
          "cxml_xpath": "@quantity (on ConfirmationItem)"
        },
        {
          "position": 3,
          "cxml_xpath": "UnitOfMeasure (on ConfirmationItem)",
          "lookup": "mapUOM355",
          "default": "EA"
        }
      ],
      "condition": null
    },
    {
      "segment_id": "CUR",
      "loop": "unknown",
      "description": "Currency — line level, emitted only if currency found",
      "elements": [
        {
          "position": 1,
          "value_fixed": "BY"
        },
        {
          "position": 2,
          "cxml_xpath": "currency value (see condition)"
        }
      ],
      "condition": "ItemIn/ItemDetail/UnitPrice/Money/@currency OR ConfirmationStatus/UnitPrice/Money/@currency"
    },
    {
      "segment_id": "CTP",
      "loop": "unknown",
      "description": "Pricing Information — first instance (AS role): unit price from ItemIn or ConfirmationStatus",
      "elements": [
        {
          "position": 1,
          "value_fixed": "AS"
        },
        {
          "position": 2,
          "logic": "If ItemIn present: 'CUP'. Else if ConfirmationStatus/UnitPrice/Money present: 'CHG'. Else: 'CUP'."
        },
        {
          "position": 3,
          "logic": "If ItemIn present: ItemIn/ItemDetail/UnitPrice/Money. Else if CHG path: ConfirmationStatus/UnitPrice/Money."
        }
      ],
      "condition": null
    },
    {
      "segment_id": "CTP",
      "loop": "unknown",
      "description": "Pricing Information — second instance (WS role): PriceBasisQuantity from ItemIn. See _CTP_MEA_PID.",
      "elements": [
        {
          "position": 1,
          "value_fixed": "WS"
        },
        {
          "position": 4,
          "cxml_xpath": "ItemDetail/PriceBasisQuantity/@quantity (on ItemIn)"
        },
        {
          "position": "501",
          "cxml_xpath": "ItemDetail/PriceBasisQuantity/UnitOfMeasure (on ItemIn)",
          "lookup": "mapUOM355"
        },
        {
          "position": 6,
          "value_fixed": "CSD"
        },
        {
          "position": 7,
          "cxml_xpath": "ItemDetail/PriceBasisQuantity/@conversionFactor (on ItemIn)"
        }
      ],
      "condition": "ItemIn/ItemDetail/PriceBasisQuantity present"
    },
    {
      "segment_id": "MEA",
      "loop": "unknown",
      "description": "Measurements — from ItemIn/ItemDetail/Dimension",
      "elements": [
        {
          "position": 1,
          "value_fixed": "PD"
        },
        {
          "position": 2,
          "cxml_xpath": "ItemDetail/Dimension/@type (on ItemIn)",
          "lookup": "mapMEA738"
        },
        {
          "position": 3,
          "cxml_xpath": "ItemDetail/Dimension/@quantity (on ItemIn)"
        },
        {
          "position": "401",
          "cxml_xpath": "ItemDetail/Dimension/UnitOfMeasure (on ItemIn)",
          "lookup": "mapUOM355"
        }
      ],
      "condition": "ItemIn/ItemDetail/Dimension present"
    },
    {
      "segment_id": "PID",
      "loop": "unknown",
      "description": "Product/Item Description — from ItemIn/ItemDetail/Description",
      "elements": [
        {
          "position": 1,
          "value_fixed": "F"
        },
        {
          "position": 5,
          "cxml_xpath": "ItemDetail/Description text (on ItemIn)"
        },
        {
          "position": 9,
          "cxml_xpath": "ItemDetail/Description/@xml:lang (on ItemIn)",
          "default": "en"
        }
      ],
      "condition": "ItemIn/ItemDetail/Description text present"
    },
    {
      "segment_id": "PID",
      "loop": "unknown",
      "description": "Product/Item Description — ShortName variant",
      "elements": [
        {
          "position": 1,
          "value_fixed": "F"
        },
        {
          "position": 2,
          "value_fixed": "GEN"
        },
        {
          "position": 5,
          "cxml_xpath": "ItemDetail/Description/ShortName (on ItemIn)"
        },
        {
          "position": 9,
          "cxml_xpath": "ItemDetail/Description/@xml:lang (on ItemIn)",
          "default": "en"
        }
      ],
      "condition": "ItemIn/ItemDetail/Description/ShortName present"
    },
    {
      "segment_id": "REF",
      "loop": "unknown",
      "description": "Reference — FL qualifier for composite/parent line item type",
      "elements": [
        {
          "position": 1,
          "value_fixed": "FL"
        },
        {
          "position": 2,
          "cxml_xpath": "@parentLineNumber (on ConfirmationItem)"
        },
        {
          "position": 3,
          "cxml_xpath": "@itemType (on ConfirmationItem)"
        }
      ],
      "condition": "ConfirmationItem/@itemType is present"
    },
    {
      "segment_id": "REF",
      "loop": "unknown",
      "description": "Reference — from ConfirmationStatus Extrinsics. Uses mapREF128 for known names or ZZ for unknown.",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "SAC",
      "loop": "unknown",
      "description": "Service, Promotion, Allowance, or Charge — line-level Shipping and Tax from ItemIn. See _SAC.",
      "elements": [],
      "condition": "ItemIn/Shipping or ItemIn/Tax present"
    },
    {
      "segment_id": "ACK",
      "loop": "for each ConfirmationStatus on ConfirmationItem",
      "description": "Line Item Acknowledgment — per ConfirmationStatus element (skipping type='unknown')",
      "elements": [
        {
          "position": 1,
          "cxml_xpath": "@type (on ConfirmationStatus)",
          "transform": "accept→IA, backordered→IB, detail→IC, reject→IR"
        },
        {
          "position": 2,
          "cxml_xpath": "@quantity (on ConfirmationStatus)"
        },
        {
          "position": 3,
          "cxml_xpath": "UnitOfMeasure (on ConfirmationStatus)",
          "lookup": "mapUOM355",
          "default": "EA"
        },
        {
          "position": 4,
          "value_fixed": "068"
        },
        {
          "position": 5,
          "cxml_xpath": "@shipmentDate (on ConfirmationStatus)",
          "transform": "YYYYMMDD; only for non-reject types",
          "condition": "@shipmentDate present AND type != 'reject'"
        },
        {
          "position": 6,
          "description": "ACK line counter (1-based integer per item)",
          "value": "incrementing counter x"
        },
        {
          "position": "7+",
          "description": "Additional qualifier/value pairs from _ACK_help",
          "logic": "complex_logic",
          "pairs": [
            {
              "qualifier": "BP",
              "cxml_xpath": "ItemIn/ItemID/BuyerPartID"
            },
            {
              "qualifier": "VP",
              "cxml_xpath": "ItemIn/ItemID/SupplierPartID"
            },
            {
              "qualifier": "VS",
              "cxml_xpath": "ItemIn/ItemID/SupplierPartAuxiliaryID"
            },
            {
              "qualifier": "MG",
              "cxml_xpath": "ItemIn/ItemDetail/ManufacturerPartID"
            },
            {
              "qualifier": "MF",
              "cxml_xpath": "ItemIn/ItemDetail/ManufacturerName"
            },
            {
              "qualifier": "PD",
              "cxml_xpath": "ItemIn/ItemDetail/Description text"
            },
            {
              "qualifier": "C3",
              "cxml_xpath": "ItemIn/ItemDetail/Classification[@domain='UNSPSC']/@code"
            },
            {
              "qualifier": "B8",
              "cxml_xpath": "@SupplierBatchID (on ConfirmationStatus)"
            },
            {
              "qualifier": "UP",
              "cxml_xpath": "ItemIn/ItemDetail/Extrinsic[@name='UPCID'] text"
            }
          ]
        }
      ],
      "condition": null
    },
    {
      "segment_id": "DTM",
      "loop": "unknown",
      "description": "Date/Time Reference — delivery date per ConfirmationStatus (non-reject only)",
      "elements": [
        {
          "position": "qualifier",
          "value_fixed": "017"
        },
        {
          "position": "date",
          "cxml_xpath": "@deliveryDate (on ConfirmationStatus)"
        }
      ],
      "condition": "@deliveryDate present on ConfirmationStatus AND type != 'reject'"
    },
    {
      "segment_id": "TXI",
      "loop": "unknown",
      "description": "Tax Information — ItemIn level TaxDetail (purpose='tax' only). See _ItemIn_Tax.",
      "elements": [
        {
          "position": 1,
          "logic": "mapTXI963_Category on @category or mapTXI963_Desc on Description text; default 'ZZ'"
        },
        {
          "position": 2,
          "cxml_xpath": "TaxAmount/Money (on TaxDetail)"
        },
        {
          "position": 3,
          "cxml_xpath": "@percentageRate (on TaxDetail)"
        },
        {
          "position": 4,
          "value_fixed": "VD"
        },
        {
          "position": 5,
          "cxml_xpath": "TaxLocation (on TaxDetail)",
          "transform": "max 10 chars"
        },
        {
          "position": 6,
          "transform": "'exempt'→'2', 'zeroRated'→'0'"
        },
        {
          "position": 8,
          "cxml_xpath": "TaxableAmount/Money (on TaxDetail)"
        },
        {
          "position": 10,
          "cxml_xpath": "Description text (on TaxDetail)"
        }
      ],
      "condition": "ItemIn/Tax/TaxDetail[@purpose='tax']"
    },
    {
      "segment_id": "SCH",
      "loop": "for each ConfirmationStatus that has ScheduleLineReference",
      "description": "Line Item Schedule — per ScheduleLineReference on ConfirmationStatus. See _ScheduleLineReference.",
      "elements": [
        {
          "position": 1,
          "cxml_xpath": "@quantity (on ScheduleLineReference)"
        },
        {
          "position": 2,
          "cxml_xpath": "UnitOfMeasure (from ConfirmationItem)",
          "lookup": "mapUOM355",
          "default": "EA"
        },
        {
          "position": 5,
          "value_fixed": "002"
        },
        {
          "position": 6,
          "cxml_xpath": "@requestedDeliveryDate (on ScheduleLineReference)",
          "transform": "YYYYMMDD"
        },
        {
          "position": 7,
          "cxml_xpath": "@requestedDeliveryDate (on ScheduleLineReference)",
          "transform": "HHMMSS"
        },
        {
          "position": 11,
          "cxml_xpath": "@lineNumber (on ScheduleLineReference)"
        }
      ],
      "condition": null
    },
    {
      "segment_id": "N9",
      "loop": "unknown",
      "description": "Reference Number (line level) — Shipping/Tax descriptions, Comments, RejectionReason, Extrinsics. See _Item_N9.",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "N1",
      "loop": "for each Contact in ConfirmationItem",
      "description": "Name group — per Contact element on ConfirmationItem",
      "elements": [],
      "condition": "complex_logic"
    },
    {
      "segment_id": "CTT",
      "loop": "unknown",
      "description": "Transaction Totals",
      "elements": [
        {
          "position": 1,
          "cxml_xpath": "count of ConfirmationItem elements",
          "note": "defaults to '1' if no items"
        }
      ],
      "condition": null
    },
    {
      "segment_id": "AMT",
      "loop": "unknown",
      "description": "Monetary Amount — total",
      "elements": [
        {
          "position": 1,
          "value_fixed": "TT"
        },
        {
          "position": 2,
          "cxml_xpath": "Total/Money (on ConfirmationHeader)"
        }
      ],
      "condition": "ConfirmationHeader/Total/Money is present"
    },
    {
      "segment_id": "SE",
      "loop": "unknown",
      "description": "",
      "elements": [],
      "condition": "fixed_envelope"
    },
    {
      "segment_id": "GE",
      "loop": "unknown",
      "description": "",
      "elements": [],
      "condition": "fixed_envelope"
    },
    {
      "segment_id": "IEA",
      "loop": "unknown",
      "description": "",
      "elements": [],
      "condition": "fixed_envelope"
    }
  ],
  "lookup_tables": {
    "mapBAK353": {
      "description": "Transaction Set Purpose Code (BAK01)",
      "values": {
        "new": "00",
        "update": "05"
      }
    },
    "mapBAK587": {
      "description": "Acknowledgment Type (BAK02)",
      "values": {
        "detail": "AC",
        "alldetail": "AC",
        "except": "AE",
        "accept": "AT",
        "reject": "RJ"
      }
    },
    "mapFOB335": {
      "description": "Incoterms for FOB05",
      "values": {
        "cfr": "CFR",
        "cif": "CIF",
        "cip": "CIP",
        "cpt": "CPT",
        "daf": "DAF",
        "ddp": "DDP",
        "ddu": "DDU",
        "deq": "DEQ",
        "des": "DES",
        "exw": "EXW",
        "fas": "FAS",
        "fca": "FCA",
        "fob": "FOB"
      }
    },
    "mapTXI963_Category": {
      "description": "Tax Type Code from @category",
      "values": {
        "gst": "CG",
        "sales": "CP",
        "usage": "UT",
        "vat": "VA"
      }
    },
    "mapTXI963_Desc": {
      "description": "Tax Type Code from Description text (partial — see source for full map)",
      "note": "large table; key examples: 'goods and services tax'→'GS', 'value added tax'→'VA', 'mutually defined'→'ZZ'"
    },
    "mapN9_RejectReason": {
      "description": "Rejection reason text normalization",
      "values": {
        "duplicateorder": "Duplicate Order",
        "incorrectdeliverydate": "Incorrect Delivery Date",
        "incorrectdescription": "Incorrect Description",
        "incorrectprice": "Incorrect Price",
        "incorrectquantity": "Incorrect Quantity",
        "incorrectstockpartnumber": "Incorrect Stock/Part Number",
        "incorrectsuppliercodeused": "Incorrect Supplier Code Used",
        "incorrectuom": "Incorrect UOM",
        "notourproductline": "Not our Product Line",
        "unabletosupplyitems": "Unable to Supply Item(s)",
        "other": "Other"
      }
    },
    "mapN1_98": {
      "description": "Entity Identifier Code (N101) from Contact @role",
      "note": "Large table; key values: buyer→BY, shipto→ST, shipfrom→SF, billto→BT, soldto→SO, remitto→RI, default→ZZ"
    },
    "mapN1_66": {
      "description": "Identification Code Qualifier (N103) from @addressIDDomain",
      "values": {
        "duns": "1",
        "scac": "2",
        "iata": "4",
        "duns+4": "9"
      }
    },
    "mapN1_REF128": {
      "description": "Reference qualifier for N1 group REF segments from IdReference @domain",
      "note": "Large table; key values: vatid→VX, federaltaxid→TJ, duns→DUN, swiftid→02, etc."
    },
    "mapREF128": {
      "description": "Reference qualifier for ConfirmationStatus Extrinsic names",
      "note": "Large table (400+ entries); known cXML extrinsic names mapped to X12 REF01 qualifiers"
    },
